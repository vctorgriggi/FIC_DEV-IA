<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>integra_clima_populacao_area</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Cruza INMET (clima) + IBGE (populacao) + IBGE (area) por municipio</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/17 20:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/17 20:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop><from>capitais (de-para)</from><to>busca populacao</to><enabled>Y</enabled></hop>
    <hop><from>staging populacao</from><to>busca populacao</to><enabled>Y</enabled></hop>
    <hop><from>busca populacao</from><to>busca area</to><enabled>Y</enabled></hop>
    <hop><from>staging area</from><to>busca area</to><enabled>Y</enabled></hop>
    <hop><from>staging clima</from><to>limpa marca provisoria</to><enabled>Y</enabled></hop>
    <hop><from>limpa marca provisoria</from><to>converte numeros</to><enabled>Y</enabled></hop>
    <hop><from>busca area</from><to>busca clima</to><enabled>Y</enabled></hop>
    <hop><from>converte numeros</from><to>busca clima</to><enabled>Y</enabled></hop>
    <hop><from>busca clima</from><to>converte numeros ibge</to><enabled>Y</enabled></hop>
    <hop><from>converte numeros ibge</from><to>calcula indicadores</to><enabled>Y</enabled></hop>
    <hop><from>calcula indicadores</from><to>ordena por densidade</to><enabled>Y</enabled></hop>
    <hop><from>ordena por densidade</from><to>resultado final</to><enabled>Y</enabled></hop>
  </order>
